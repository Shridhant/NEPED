{
  "kind": "collectionType",
  "collectionName": "gallery_albums",
  "info": {
    "singularName": "gallery-album",
    "pluralName": "gallery-albums",
    "displayName": "Gallery Album",
    "description": "Albums on the Gallery page. Each photo's alt text is set in the Media Library."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 100
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "required": true,
      "allowedTypes": ["images"]
    }
  }
}
