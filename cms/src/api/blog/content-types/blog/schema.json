{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": "Blog articles."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["Technology", "Field Reports", "Community", "Policy"],
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "readTime": {
      "type": "string"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "authorName": {
      "type": "string"
    },
    "authorRole": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "blog.section"
    },
    "takeaways": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    },
    "tags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.text-item"
    }
  }
}
